# gh_embed(<out.cpp> <symbol> <file> [<symbol> <file> ...])
# Writes a C++ file that holds each file as a byte array `symbol` with its length `symbolSize`.
function(gh_embed output)
  set(text "// Generated by cmake/embed.cmake - do not edit.\n")
  set(rest ${ARGN})
  while(rest)
    list(POP_FRONT rest symbol path)
    file(READ "${path}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND text "extern const unsigned char ${symbol}[] = {${bytes}};\n")
    string(APPEND text "extern const unsigned int ${symbol}Size = sizeof ${symbol};\n")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
  endwhile()
  file(WRITE "${output}.tmp" "${text}")
  file(COPY_FILE "${output}.tmp" "${output}" ONLY_IF_DIFFERENT)
  file(REMOVE "${output}.tmp")
endfunction()
